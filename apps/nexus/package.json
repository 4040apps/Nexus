{
  "name": "@nexus/app-nexus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "preview:dashboard": "node dist/dashboard-preview.js",
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts src/check-readiness.ts src/dashboard-preview.ts --format esm --dts --clean",
    "check:readiness": "node dist/check-readiness.js"
  },
  "dependencies": {
    "@nexus/goal-state": "workspace:*",
    "@nexus/intent-handoff": "workspace:*",
    "@nexus/webmcp": "workspace:*"
  }
}
