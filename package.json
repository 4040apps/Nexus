{
  "name": "nexus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/**' dev",
    "spike:webmcp": "pnpm --filter @nexus/webmcp-cross-origin-spike build && pnpm --filter @nexus/webmcp-cross-origin-spike start",
    "demo:officepro": "pnpm --filter @nexus/app-nexus build && pnpm --filter @nexus/app-officepro build && pnpm --filter @nexus/app-techsupply build && pnpm --parallel --filter @nexus/app-nexus --filter @nexus/app-officepro --filter @nexus/app-techsupply preview:brand",
    "demo:hero": "pnpm demo:officepro",
    "lint": "eslint .",
    "typecheck": "pnpm --recursive typecheck",
    "test": "vitest run",
    "build": "pnpm --recursive build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
